{
  "name": "tongs-desktop-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node scripts/build.mjs --clean",
    "build": "node scripts/build.mjs --prepare && tsc -p tsconfig.json && node scripts/build.mjs",
    "test": "npm run build && node --test --test-concurrency=1 --import ../tests/desktop/renderer/setup.mjs ../tests/desktop/electron/*.test.mjs ../tests/desktop/renderer/*.test.mjs",
    "start": "npm run build && electron .",
    "format": "npm --prefix tools/lint run format",
    "format:check": "npm --prefix tools/lint run format:check",
    "lint": "npm --prefix tools/lint run lint"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.2.0",
    "esbuild": "0.28.2",
    "jsdom": "27.0.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "lowlight": "3.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  }
}
